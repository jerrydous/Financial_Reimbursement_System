# 仅用于本地开发。不要把真实口令写进仓库。
POSTGRES_USER=frs
POSTGRES_PASSWORD=frs
POSTGRES_DB=frs
DATABASE_URL=postgresql://frs:frs@localhost:5432/frs

# 浏览器和 API 必须使用同一个 Keycloak 地址，令牌里的 iss 才能校验通过。
KEYCLOAK_URL=http://localhost:8088
KEYCLOAK_REALM=expense
KEYCLOAK_API_CLIENT=web
KEYCLOAK_DEV_USER=employee1
KEYCLOAK_DEV_PASSWORD=employee1

TEMPORAL_ADDRESS=localhost:7233
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=frs
S3_SECRET_KEY=frs-dev-secret
S3_BUCKET=invoices
INTERNAL_TOKEN=dev-internal-token
API_INTERNAL_URL=http://127.0.0.1:3000

API_PORT=3000
WORKER_PORT=3001
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info

VITE_KEYCLOAK_URL=http://localhost:8088
VITE_KEYCLOAK_REALM=expense
VITE_KEYCLOAK_CLIENT=web
VITE_API_URL=http://localhost:3000

# 识票。留空或 tesseract：本机开源 OCR 读票面，再由系统填写草稿。tencent 使用腾讯云。off 则完全手工填写。
OCR_PROVIDER=tesseract
VERIFY_PROVIDER=
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_OCR_REGION=ap-guangzhou

# 金蝶凭证和商旅拉取。留空时只生成报文或接收推送的订单，不会假装已经投递成功。
KINGDEE_BASE_URL=
TRAVEL_PULL_URL=
