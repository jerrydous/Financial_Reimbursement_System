# 复制为 deploy/.env 后再启动。PUBLIC_ORIGIN 不要以斜杠结尾。
# 改 PUBLIC_ORIGIN 后必须重新构建网页镜像。

# 只用 IP、还没有域名时：
PUBLIC_ORIGIN=http://203.0.113.10
CADDY_SITE=:80

# 有域名并要自动申请证书时，改成下面两行，并放行 80 和 443：
# PUBLIC_ORIGIN=https://expense.example.com
# CADDY_SITE=expense.example.com

HTTP_PORT=80
HTTPS_PORT=443

POSTGRES_USER=frs
POSTGRES_PASSWORD=请换成足够长的数据库口令
POSTGRES_DB=frs

S3_ACCESS_KEY=frs
S3_SECRET_KEY=请换成对象存储口令
S3_BUCKET=invoices

INTERNAL_TOKEN=请换成内部调用令牌
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=请换成管理员口令

# 第一次启动写示例公司和四个账号。登录成功后改为 false，避免每次重启覆盖公司名称。
SEED_ON_START=true
OCR_PROVIDER=tesseract
